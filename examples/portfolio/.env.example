# Copy to .env and fill in real values. CanyonOS reads it to resolve ${...}
# placeholders in config/global_controller.yaml and passes it to the agent
# replicas; the endpoint does not get it.

# --- Baseten Model APIs (intent_agent, advisor_agent) ---
# Real Baseten API key, used to reach Baseten through the CanyonOS LLM gateway.
BASETEN_API_KEY=

# --- AWS EC2 (provider: EC2, config/global_controller.yaml's ec2: block) ---
EC2_REGION=
EC2_SUBNET_ID=
EC2_SECURITY_GROUP_ID=
