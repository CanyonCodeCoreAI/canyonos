# Copy to .env and fill in real values. CanyonOS reads it to resolve ${...}
# placeholders in config/workflow_config.yaml and passes it to the agent
# replicas; the endpoint does not get it.

# --- OpenAI (intent_agent, advisor_agent) ---
# Real OpenAI API key, used to reach OpenAI through the CanyonOS LLM gateway.
OPENAI_API_KEY=

# The model both agents call. Defaults to gpt-4o-mini when unset.
# OPENAI_MODEL_ID=

# --- AWS EC2 (provider: ec2-pool, config/workflow_config.yaml's ec2-pool: block) ---
# EC2_REGION=
# EC2_SUBNET_ID=
# EC2_SECURITY_GROUP_ID=
