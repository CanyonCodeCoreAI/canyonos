# Copy to .env and fill in real values. CanyonOS reads it to resolve ${...}
# placeholders in config/ and passes it to the agent replicas.

# --- AWS Bedrock (review_agent) ---
# An IAM user allowed to invoke both models below in AWS_REGION.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0

# The cheaper model governance.yaml switches ReviewAgent to once its spend passes $5.
BEDROCK_SWITCH_MODEL_ID=meta.llama3-8b-instruct-v1:0
