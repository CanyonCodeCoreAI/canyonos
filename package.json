{
  "name": "canyonos",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.1"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "license:check": "turbo run license:check",
    "check": "turbo run lint typecheck format:check license:check",
    "format": "turbo run format",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:sdk": "bun run --filter @canyonos/api build:sdk",
    "build:binary": "turbo run build:binary",
    "docker:up": "docker compose --env-file .docker/.env -f .docker/docker-compose.yml up -d --wait",
    "docker:down": "docker compose --env-file .docker/.env -f .docker/docker-compose.yml down",
    "docker:rm": "docker compose --env-file .docker/.env -f .docker/docker-compose.yml down --volumes",
    "docker:logs": "docker compose --env-file .docker/.env -f .docker/docker-compose.yml logs -f",
    "canyonos:dev": "bun run ./scripts/canyonos-dev.ts",
    "dashboard:dev": "bun run ./scripts/dashboard-dev.ts",
    "api:test:e2e": "bun run --filter @canyonos/api test:e2e",
    "cli:test:e2e": "turbo run test:e2e --filter=canyonos",
    "ui:test:e2e": "bun run --filter web test:e2e",
    "canyonos:smoke": "bun run ./scripts/canyonos-smoke.ts",
    "version:check": "bun run ./scripts/release-version.ts check",
    "version:set": "bun run ./scripts/release-version.ts set",
    "formula:write": "bun run ./scripts/homebrew-formula.ts",
    "supported-versions:write": "bun run ./scripts/supported-versions.ts",
    "dev:emails": "bun run --filter @canyonos/api dev:emails",
    "cli:usage:dev": "bun run ./packages/cli-usage-api/scripts/dev.ts",
    "cli:usage:reset": "bun run --cwd packages/cli-usage-api reset",
    "cli:usage:test:e2e": "bun run --cwd packages/cli-usage-api test:e2e",
    "cli:usage:test:cli-e2e": "CANYONOS_CLI_USAGE_E2E=1 uv run pytest tests/cli_usage",
    "skills:test": "bun test scripts/skills-check.test.ts",
    "skills:check": "bun run skills:test && promptfoo validate config -c evals/promptfooconfig.js && bun run scripts/skills-promptfoo-smoke.ts",
    "skills:eval": "PROMPTFOO_CONFIG_DIR=.promptfoo promptfoo eval -c evals/promptfooconfig.js --env-file .env",
    "skills:eval:view": "PROMPTFOO_CONFIG_DIR=.promptfoo promptfoo view .promptfoo"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/bun": "^1.3.1",
    "@types/node": "^22.10.5",
    "bun-types": "^1.3.2",
    "dotenv": "^17.2.3",
    "oxlint": "1.25.0",
    "oxlint-tsgolint": "0.4.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "promptfoo": "0.124.1",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  }
}
