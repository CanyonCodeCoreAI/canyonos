{
  "openapi": "3.1.0",
  "info": {
    "title": "CanyonOS Global Controller",
    "version": "1"
  },
  "paths": {
    "/v1/workflow-groups": {
      "get": {
        "tags": ["default"],
        "summary": "List the workflow groups",
        "description": "Return the one workflow group this server holds, with the name its last `PUT`<br/>gave it.",
        "operationId": "list_workflow_groups_v1_workflow_groups_get",
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowGroups"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflow-groups/{workflow_group_id}": {
      "get": {
        "tags": ["default"],
        "summary": "Read the workflow group's status",
        "description": "Report the workflow group's name and `workflow_group.yaml` as last uploaded, how<br/>far the apply loop got, the deploy's phase, progress and verdict, and while it runs,<br/>its endpoint, agents and machine errors read from Redis; a part that could not be<br/>read is left null and named under `errors`.",
        "operationId": "status_v1_workflow_groups__workflow_group_id__get",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["default"],
        "summary": "Upload workflow_group.yaml and its .env",
        "description": "Write `workflow_group.yaml` and the `.env` beside it into `/workspace`, removing<br/>that `.env` when `env` is null, and keep `name` as the workflow group's name. With<br/>`workflows`, remove the uploaded workflows it leaves out; with `api_key_hash`, keep<br/>it as the workflow group's API key, none when it is empty.",
        "operationId": "put_workflow_group_v1_workflow_groups__workflow_group_id__put",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowGroupBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Uploaded"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["default"],
        "summary": "Stop the deploy and remove the upload",
        "description": "Remove everything uploaded to `/workspace`, then wait for the apply loop to stop<br/>the deploy; 504 if it did not stop in time, 500 if stopping it failed.",
        "operationId": "delete_workflow_group_v1_workflow_groups__workflow_group_id__delete",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflow-groups/{workflow_group_id}/workflows/{name}": {
      "get": {
        "tags": ["default"],
        "summary": "Read a workflow",
        "description": "Return uploaded workflow `name`; 404 if it was never uploaded.",
        "operationId": "get_workflow_v1_workflow_groups__workflow_group_id__workflows__name__get",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Name",
              "pattern": "^(?!\\.\\.?$)[^/]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workflow"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["default"],
        "summary": "Upload a workflow",
        "description": "Check the uploaded gzip tar of workflow `name` as `canyonos validate` does, then<br/>unpack it into `/workspace/<name>`, removing what its last upload had and this one<br/>lacks; on a 400 (bad archive, unsafe path or findings) the old files stay.",
        "operationId": "put_workflow_v1_workflow_groups__workflow_group_id__workflows__name__put",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Name",
              "pattern": "^(?!\\.\\.?$)[^/]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/gzip": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Uploaded"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["default"],
        "summary": "Remove a workflow",
        "description": "Remove from `/workspace` what workflow `name`'s last upload put there; 404 if it<br/>was never uploaded.",
        "operationId": "delete_workflow_v1_workflow_groups__workflow_group_id__workflows__name__delete",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Name",
              "pattern": "^(?!\\.\\.?$)[^/]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflow-groups/{workflow_group_id}/logs/controller": {
      "get": {
        "tags": ["default"],
        "summary": "Read the controller log",
        "description": "Return the deploy process's kept output, the last `tail` lines of it, as text;<br/>with `follow=true`, keep streaming new lines until the process has exited and every<br/>line was sent. Empty when nothing was deployed yet.",
        "operationId": "controller_log_v1_workflow_groups__workflow_group_id__logs_controller_get",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          },
          {
            "name": "tail",
            "in": "query",
            "required": false,
            "schema": {
              "title": "Tail",
              "pattern": "^(\\d+|all)$",
              "type": "string",
              "default": "all"
            }
          },
          {
            "name": "follow",
            "in": "query",
            "required": false,
            "schema": {
              "title": "Follow",
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflow-groups/{workflow_group_id}/health": {
      "get": {
        "tags": ["default"],
        "summary": "Check the running deploy",
        "description": "Check the running deploy's Global Controller, Redis, each agent's replica count<br/>and its endpoint, each with how to fix it when it fails; 409 if no deploy is<br/>running.",
        "operationId": "health_v1_workflow_groups__workflow_group_id__health_get",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflow-groups/{workflow_group_id}/workflows": {
      "get": {
        "tags": ["default"],
        "summary": "List the uploaded workflows",
        "description": "Return every uploaded workflow, by name.",
        "operationId": "list_workflows_v1_workflow_groups__workflow_group_id__workflows_get",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workflows"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflow-groups/{workflow_group_id}/logs/agents/{name}": {
      "get": {
        "tags": ["default"],
        "summary": "Read an agent's replica logs",
        "description": "Return the last `tail` lines of each running replica of agent `name`, or of the<br/>one replica whose ID is `name`, read on its machine; 409 if no deploy is running,<br/>404 naming the agents when `name` is neither, 503 when Redis cannot be read.",
        "operationId": "logs_v1_workflow_groups__workflow_group_id__logs_agents__name__get",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "name": "tail",
            "in": "query",
            "required": false,
            "schema": {
              "title": "Tail",
              "pattern": "^(\\d+|all)$",
              "type": "string",
              "default": "all"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplicaLogs"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflow-groups/{workflow_group_id}/dashboard": {
      "put": {
        "tags": ["default"],
        "summary": "Register the workflow group's Redis with the dashboard",
        "description": "Send this workflow group's Redis host, port and password, plus a client<br/>certificate its CA signs when its Redis takes only TLS, to the dashboard api at<br/>`url` and return the workflows it registered. Connection failures and 5xx answers<br/>are retried for a minute; 502 when the api refuses it or never answers.",
        "operationId": "put_dashboard_v1_workflow_groups__workflow_group_id__dashboard_put",
        "parameters": [
          {
            "name": "workflow_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Workflow Group Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DashboardBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardWorkflows"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "title": "Error",
        "required": ["error", "code"],
        "type": "object",
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "enum": [
              "bad_request",
              "bad_archive",
              "workflow_invalid",
              "unauthenticated",
              "forbidden",
              "unknown_workflow_group",
              "unknown_workflow",
              "unknown_agent",
              "not_running",
              "replicas_unreadable",
              "stop_timeout",
              "stop_failed",
              "dashboard_unreachable",
              "dashboard_refused"
            ],
            "type": "string"
          },
          "findings": {
            "title": "Findings",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "warnings": {
            "title": "Warnings",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "description": "Every error answer; `findings` and `warnings` only come with\n`workflow_invalid`."
      },
      "WorkflowGroups": {
        "title": "WorkflowGroups",
        "required": ["workflow_groups"],
        "type": "object",
        "properties": {
          "workflow_groups": {
            "title": "Workflow Groups",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowGroup"
            }
          }
        }
      },
      "WorkflowGroup": {
        "title": "WorkflowGroup",
        "required": ["workflow_group_id", "name"],
        "type": "object",
        "properties": {
          "workflow_group_id": {
            "title": "Workflow Group Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "description": "`name` is what the workflow group's `PUT` last sent, empty before one."
      },
      "Uploaded": {
        "title": "Uploaded",
        "required": ["generation", "warnings"],
        "type": "object",
        "properties": {
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "warnings": {
            "title": "Warnings",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "`warnings` name problems in the upload that don't stop the deploy."
      },
      "WorkflowGroupBody": {
        "title": "WorkflowGroupBody",
        "required": ["name", "config", "env"],
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "config": {
            "title": "Config",
            "type": "string"
          },
          "env": {
            "title": "Env",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "workflows": {
            "title": "Workflows",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "api_key_hash": {
            "title": "Api Key Hash",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "description": "`config` is `workflow_group.yaml`'s text and `env` the `.env` beside it, null for\nnone. `workflows`, when given, is every workflow the workflow group has; the\nuploaded workflows it leaves out are removed. `api_key_hash`, when given, is the\nSHA-256 of the deploy's API key, \"\" for none, used only on Kubernetes, where a\nchange restarts the deploy."
      },
      "Generation": {
        "title": "Generation",
        "required": ["generation"],
        "type": "object",
        "properties": {
          "generation": {
            "title": "Generation",
            "type": "integer"
          }
        }
      },
      "Status": {
        "title": "Status",
        "required": [
          "version",
          "name",
          "config",
          "running",
          "phase",
          "message",
          "steps",
          "slowest_step",
          "idle_seconds",
          "error",
          "error_code",
          "root_cause",
          "endpoint",
          "agents",
          "machine_errors",
          "generation",
          "applied_generation",
          "applying",
          "last_apply",
          "errors"
        ],
        "type": "object",
        "properties": {
          "version": {
            "title": "Version",
            "type": "string"
          },
