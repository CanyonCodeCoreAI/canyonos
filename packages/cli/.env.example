# Development environment for the CLI. Copy this file to packages/cli/.env (gitignored)
# and run the CLI from source with `uv run canyonos <command>`.
# Without a packages/cli/.env the CLI is in `production` and every knob below is refused.
# Shell variables win over this file. See packages/cli/DEVELOPMENT.md.
CANYONOS_ENV=development

# Global Controller image. `local` is the image built from this checkout with
# `bun run canyonos:dev`
CANYONOS_CORE_IMAGE=local   # prod | local | <image tag>

# Porting skill. `local` is .claude/skills/porting-to-canyonos in this checkout.
CANYONOS_SKILL_SOURCE=local   # prod | local | <dir or git ref>

# Dashboard images. Unset means the versions the CLI pins.
CANYONOS_API_IMAGE=local   # prod | local | <image tag>
CANYONOS_WEB_IMAGE=local   # prod | local | <image tag>
