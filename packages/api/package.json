{
  "name": "@canyonos/api",
  "version": "0.2.3-dev3",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    },
    "./requests": {
      "types": "./dist/requests.d.ts",
      "import": "./dist/requests.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./monitoring": {
      "types": "./dist/monitoring.d.ts",
      "import": "./dist/monitoring.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "import": "./dist/prompts.js"
    },
    "./scaling": {
      "types": "./dist/scaling.d.ts",
      "import": "./dist/scaling.js"
    },
    "./governance": {
      "types": "./dist/governance.d.ts",
      "import": "./dist/governance.js"
    },
    "./workflow-groups": {
      "types": "./dist/workflow-groups.d.ts",
      "import": "./dist/workflow-groups.js"
    }
  },
  "scripts": {
    "build": "bun run build:sdk",
    "build:sdk": "tsup",
    "dev": "concurrently -n server,sdk -c blue,cyan \"bun run dev:server\" \"bun run dev:sdk\"",
    "dev:server": "bun run --watch src/server.ts",
    "dev:sdk": "tsup --watch",
    "start": "bun run src/server.ts",
    "api:openapi": "bun run src/openapi.ts && prettier --ignore-path ../../.gitignore --write openapi.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "bun test --bail --env-file .env.test --preload ./src/test/setup.ts src/test/e2e.*.test.ts",
    "test:no-database": "DATABASE_URL=postgres://canyonos:canyonos@127.0.0.1:1/canyonos CANYONOS_API_KEY_HASH= PORT=3005 API_URL=http://localhost:3005 bun test --bail --env-file .env.test src/test/no-database.test.ts",
    "test:migration": "PORT=3004 API_URL=http://localhost:3004 bun test --bail --env-file .env.test --preload ./src/test/setup.ts src/test/migration.populated.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json .",
    "format": "prettier --ignore-path ../../.gitignore --write .",
    "format:check": "prettier --ignore-path ../../.gitignore --check ."
  },
  "peerDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "zod": ">=3.25.3 <4"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "diff": "^7.0.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.29",
    "pino": "^10.1.1",
    "postgres": "^3.4.9",
    "protobufjs": "^8.8.0",
    "zod": "^3.25.3",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@canyonos/tsconfig": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@types/diff": "^7.0.0",
    "bun-types": "^1.3.2",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
