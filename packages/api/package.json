{
  "name": "@canyonos/api",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./companies": {
      "types": "./dist/companies.d.ts",
      "import": "./dist/companies.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding.d.ts",
      "import": "./dist/onboarding.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./projects": {
      "types": "./dist/projects.d.ts",
      "import": "./dist/projects.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    },
    "./deploy": {
      "types": "./dist/deploy.d.ts",
      "import": "./dist/deploy.js"
    },
    "./requests": {
      "types": "./dist/requests.d.ts",
      "import": "./dist/requests.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    }
  },
  "scripts": {
    "build": "bun run build:sdk",
    "build:sdk": "tsup",
    "dev": "concurrently -n server,sdk -c blue,cyan \"bun run dev:server\" \"bun run dev:sdk\"",
    "dev:server": "bun run --watch src/server.ts",
    "dev:sdk": "tsup --watch",
    "start": "bun run src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev:emails": "email dev -d ./src/emails/templates -p 8888",
    "test": "bun test --env-file .env.example src/modules",
    "test:all": "bun test --env-file .env --preload ./src/test/setup.ts",
    "test:unit": "bun test --env-file .env src/modules",
    "test:e2e": "bun test --bail --env-file .env --env-file .env.test --preload ./src/test/setup.ts src/test/e2e.*.test.ts",
    "test:canyonos": "AUTH_MODE=fixed_code SMTP_HOST= SMTP_PORT= CANYONOS_REDIS_HOST=127.0.0.1 CANYONOS_REDIS_PORT=1 PORT=3002 API_URL=http://localhost:3002 bun test --bail --env-file .env --env-file .env.test --preload ./src/test/setup.ts src/test/self-host.bootstrap.test.ts",
    "test:deploy-disabled": "DEPLOY_WORKER=none PORT=3004 API_URL=http://localhost:3004 bun test --bail --env-file .env --env-file .env.test --preload ./src/test/setup.ts src/test/deploy-disabled.test.ts",
    "test:auth-email": "AUTH_MODE=email_otp SMTP_HOST=localhost SMTP_PORT=1025 CANYONOS_REDIS_HOST=127.0.0.1 CANYONOS_REDIS_PORT=1 PORT=3003 API_URL=http://localhost:3003 bun test --bail --env-file .env --env-file .env.test --preload ./src/test/setup.ts src/test/auth-email.test.ts",
    "test:auth-email-mail-failure": "AUTH_MODE=email_otp SMTP_HOST=localhost SMTP_PORT=1 PORT=3005 API_URL=http://localhost:3005 bun test --bail --env-file .env --env-file .env.test --preload ./src/test/setup.ts src/test/auth-email-mail-failure.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json .",
    "format": "prettier --ignore-path ../../.gitignore --write .",
    "format:check": "prettier --ignore-path ../../.gitignore --check ."
  },
  "peerDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "zod": ">=3.25.3 <4"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "diff": "^7.0.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.28",
    "jose": "^6.2.3",
    "nodemailer": "^9.0.0",
    "pino": "^10.1.1",
    "postgres": "^3.4.9",
    "protobufjs": "^8.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.20.8",
    "zod": "^3.25.3",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@canyonos/tsconfig": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@types/diff": "^7.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bun-types": "^1.3.2",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "react-email": "^6.6.3",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
