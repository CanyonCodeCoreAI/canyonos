NODE_ENV=development
# Allowed: development, test, production, demo, staging. Defaults to NODE_ENV when unset.
APP_ENV=development
PORT=3000
HOST=0.0.0.0
API_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug
SERVICE_NAME=canyonos-api
# Unset or empty, development and test use this local database and anywhere else the API refuses
# to start. The API listens before it connects: /v1/healthz answers at once, /v1/readyz once the database
# is migrated, and every route that reads it answers 503 until then.
DATABASE_URL=postgres://canyonos:canyonos@localhost:5432/canyonos
# Each workflow group's own API key is the one it was deployed with, kept in the database.
# The sha256 of this machine's deploy key in lowercase hex, which creating a workflow group on
# Docker then needs as `Authorization: Bearer <key>`. Unset or empty, creating one needs no key.
# Make one with: printf %s "<key>" | sha256sum
# CANYONOS_DEPLOY_KEY_HASH=
# With SEED_DEV_DATA, the sha256 of the API key every seeded workflow group takes; unset, they are
# open.
# SEED_DEV_API_KEY_HASH=
# Encrypts each workflow's Redis password in the database. Development and test fall back to a
# fixed key; anywhere else the API refuses to start without 32 characters or more:
# openssl rand -base64 32
# REDIS_PASSWORD_ENCRYPTION_KEY=
# How often, in milliseconds, the API visits the Redis of every registered workflow: it publishes
# governance spend and the prompts made live in the dashboard.
# WORKFLOWS_TICK_INTERVAL_MS=60000
# CANYONOS_REDIS_HOST=host.docker.internal
# CANYONOS_REDIS_PORT=6379
# Days of raw metric ticks kept; the dashboard reads them for ranges of 30 minutes or less.
# METRICS_RAW_RETENTION_DAYS=3
# Days of five-minute metric rollups kept; the dashboard reads them for longer ranges.
# METRICS_ROLLUP_RETENTION_DAYS=120
# Where /v1 runs workflow groups: `kubernetes` in the cluster this API runs in (the operator chart
# sets it), else Docker through DOCKER_SOCKET.
# CANYONOS_TARGET=
# Docker only: the container this API runs in (the dashboard's compose file sets it), which joins
# each workflow group's network to reach its Redis by name. Unset on the host, it joins none.
# CANYONOS_API_CONTAINER=
# Kubernetes only: another API server than the pod's own, such as `kubectl proxy`, called with no
# token; the folder of the service account token, CA and namespace; and the emptyDir shared with
# the core sidecar.
# CANYONOS_K8S_API=
# CANYONOS_K8S_SERVICE_ACCOUNT_DIR=/var/run/secrets/kubernetes.io/serviceaccount
# CANYONOS_WORKSPACE_DIR=/workspace
