NODE_ENV=development
# Allowed: development, test, production, demo, staging. Defaults to NODE_ENV when unset.
APP_ENV=development
PORT=3000
HOST=0.0.0.0
API_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug
SERVICE_NAME=canyonos-api
DATABASE_URL=postgres://canyonos:canyonos@localhost:5432/canyonos
# none: no sign-in, anyone who reaches the API reads every project. password: accounts and a JWT
# bearer on every project route. JWT_SECRET is read only in password mode.
AUTH_MODE=none
# Generate a real secret for any non-local use: openssl rand -base64 32
JWT_SECRET=changeme-generate-with-openssl-rand-base64-32
# CANYONOS_REDIS_HOST=host.docker.internal
# CANYONOS_REDIS_PORT=6379
# Days of raw metric ticks kept; the dashboard reads them for ranges of 30 minutes or less.
# METRICS_RAW_RETENTION_DAYS=3
# Days of five-minute metric rollups kept; the dashboard reads them for longer ranges.
# METRICS_ROLLUP_RETENTION_DAYS=120
