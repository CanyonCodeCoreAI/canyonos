NODE_ENV=development
# Allowed: development, test, production, demo, staging. Defaults to NODE_ENV when unset.
APP_ENV=development
PORT=3000
HOST=0.0.0.0
API_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug
SERVICE_NAME=canyonos-api
DATABASE_URL=postgres://canyonos:canyonos@localhost:5432/canyonos
# The sha256 of the API key in lowercase hex: every project route then needs
# `Authorization: Bearer <key>`. Unset or empty, anyone who reaches the API reads and changes every
# project. Make one with: printf %s "<key>" | sha256sum
# CANYONOS_API_KEY_HASH=
# Encrypts each project's Redis password in the database. Development and test fall back to a
# fixed key; anywhere else the API refuses to start without 32 characters or more:
# openssl rand -base64 32
# REDIS_PASSWORD_ENCRYPTION_KEY=
# CANYONOS_REDIS_HOST=host.docker.internal
# CANYONOS_REDIS_PORT=6379
# Days of raw metric ticks kept; the dashboard reads them for ranges of 30 minutes or less.
# METRICS_RAW_RETENTION_DAYS=3
# Days of five-minute metric rollups kept; the dashboard reads them for longer ranges.
# METRICS_ROLLUP_RETENTION_DAYS=120
