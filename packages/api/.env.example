NODE_ENV=development
# Allowed: development, test, production, demo, staging. Defaults to NODE_ENV when unset.
APP_ENV=development
PORT=3000
HOST=0.0.0.0
API_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug
SERVICE_NAME=canyonos-api
DATABASE_URL=postgres://canyonos:canyonos@localhost:5432/canyonos
# Only AUTH_MODE=email_otp reads these.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Generate a real secret for any non-local use: openssl rand -base64 32
JWT_SECRET=changeme-generate-with-openssl-rand-base64-32
AUTH_EMAIL_FROM=noreply@canyonos.test
# AUTH_MODE=fixed_code (default) bootstraps the self-hosted admin owner plus the project the
# controller published in Redis, and lets any email sign in with the fixed code 111111. Set to
# `email_otp` for real OTP over SMTP — that mode refuses to start unless SMTP, a real
# AUTH_EMAIL_FROM, and a real JWT_SECRET are all set.
AUTH_MODE=fixed_code
# CANYONOS_REDIS_HOST=host.docker.internal
# CANYONOS_REDIS_PORT=6379
