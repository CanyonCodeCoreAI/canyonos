# CanyonOS self-hosted dashboard. Selected by the `canyonos` stage in Dockerfile.web.

:{$PORT:8080}

root * /srv

header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	-Server
}

# Vite fingerprints assets, so they can be cached forever.
header /assets/* Cache-Control "public, max-age=31536000, immutable"

# Caddy sorts `handle` ahead of `handle_path`, so a broad `handle` added above would take
# these paths before the proxy sees them. Keep the catch-all last and keep it the only one.
handle /healthz {
	respond "ok" 200
}

# What the dashboard reads and sets of one workflow, under its workflow group. Matched on the
# request as it was sent, so an encoded `/` cannot make another route look like one of these. A
# named matcher keeps its place in this file, so this comes before the 404 below.
@workflow_dashboard `{http.request.uri}.matches("^/api/v1/workflow-groups/[0-9a-fA-F-]+/workflows/[0-9a-fA-F-]+/(requests|metrics|monitoring|prompts|scaling|governance|history|sample-data)([/?].*)?$")`
handle @workflow_dashboard {
	uri strip_prefix /api
	reverse_proxy {$CANYONOS_API_UPSTREAM:api:3000}
}

# The other workflow groups routes drive Docker on this machine or take a Global Controller's
# telemetry: they are called on the API's own port, never through the dashboard's public one.
handle /api/v1/workflow-groups* {
	respond 404
}

# The dashboard and the API share one origin, so the bundle carries no host. `handle_path`
# strips `/api` before forwarding.
handle_path /api/* {
	reverse_proxy {$CANYONOS_API_UPSTREAM:api:3000}
}

handle {
	# Production builds emit hidden sourcemaps; never serve them.
	@sourcemaps path *.map
	route @sourcemaps {
		respond 404
	}

	# SPA routing: serve real files, fall back to index.html for client routes.
	route {
		try_files {path} /index.html
		file_server
	}
}

encode zstd gzip
