{
  "name": "@repo/ui",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json .",
    "format": "prettier --ignore-path ../../.gitignore --write .",
    "format:check": "prettier --ignore-path ../../.gitignore --check ."
  },
  "exports": {
    ".": "./src/*",
    "./styles": "./src/styles/index.css",
    "./utils": "./src/lib/utils.ts",
    "./lib/*": [
      "./src/lib/*.ts",
      "./src/lib/*.tsx"
    ],
    "./shadcn/*": [
      "./src/shadcn/*.tsx",
      "./src/shadcn/*.ts",
      "./src/shadcn/*/index.tsx",
      "./src/shadcn/*/index.ts"
    ],
    "./components/flow": "./src/components/flow/index.ts",
    "./components/editor": "./src/components/editor/index.ts",
    "./components/*": [
      "./src/components/*.tsx",
      "./src/components/*/index.tsx",
      "./src/components/*/index.ts"
    ],
    "./hooks/*": [
      "./src/hooks/*.ts",
      "./src/hooks/*.tsx"
    ]
  },
  "dependencies": {
    "@cc-forge/api": "workspace:*",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.13",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.456.0",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.2.4"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@cc-forge/tsconfig": "workspace:*",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "5.9.3"
  }
}
