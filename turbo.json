{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalPythonWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "tasks": {
    "build": {
      "cache": true,
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "@cc-forge/api#typecheck": {
      "dependsOn": ["build"]
    },
    "web#build": {
      "dependsOn": ["^build"]
    },
    "web#typecheck": {
      "dependsOn": ["^build"]
    },
    "web#lint": {
      "dependsOn": ["^build"]
    },
    "web#test": {
      "dependsOn": ["^build"]
    },
    "@repo/ui#lint": {
      "dependsOn": ["^build"]
    },
    "@repo/ui#typecheck": {
      "dependsOn": ["^build"]
    },
    "@repo/ui#test": {
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "test": {},
    "canyonos#build:binary": {
      "cache": false,
      "command": [
        "uv",
        "run",
        "--no-sync",
        "python",
        "-m",
        "nuitka",
        "--mode=onefile",
        "--output-dir=dist",
        "--include-data-file=canyonos/dashboard.compose.yml=canyonos/dashboard.compose.yml",
        "--include-distribution-metadata=canyonos",
        "--assume-yes-for-downloads",
        "cli.py"
      ]
    },
    "canyonos-python#test": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "pytest",
        "tests"
      ],
      "inputs": [
        "tests/**",
        "!tests/**/__pycache__/**",
        ".claude/skills/porting-to-canyonos/**",
        "pyproject.toml",
        "uv.lock"
      ]
    },
    "canyonos-python#lint": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "ruff",
        "check",
        "."
      ]
    },
    "canyonos-python#typecheck": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "ty",
        "check"
      ]
    },
    "canyonos-python#format": {
      "cache": false,
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "ruff",
        "format",
        "."
      ]
    },
    "canyonos-python#format:check": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "ruff",
        "format",
        "--check",
        "."
      ]
    }
  }
}
