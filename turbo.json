{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalPythonWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "globalPassThroughEnv": [
    "APP_ENV",
    "API_URL",
    "AUTH_MODE",
    "CANYONOS_REDIS_HOST",
    "CANYONOS_REDIS_PORT",
    "DATABASE_URL",
    "DEPLOY_WORKER",
    "JWT_SECRET",
    "NODE_ENV",
    "PLAYWRIGHT_BASE_URL",
    "PORT",
    "VITE_API_URL",
    "VITE_WEB_PORT",
    "WEB_PUBLIC_URL"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["SEED_DEV_DATA"]
    },
    "build": {
      "cache": true,
      "outputs": ["dist/**"]
    },
    "//#starters:bundle": {
      "cache": false,
      "inputs": ["$TURBO_ROOT$/examples/**", "$TURBO_ROOT$/scripts/bundle-starters.ts"]
    },
    "lint": {},
    "typecheck": {},
    "@canyonos/api#typecheck": {
      "dependsOn": ["build"]
    },
    "web#build": {
      "dependsOn": ["^build"]
    },
    "web#typecheck": {
      "dependsOn": ["^build"]
    },
    "web#lint": {
      "dependsOn": ["^build"]
    },
    "@repo/ui#lint": {
      "dependsOn": ["^build"]
    },
    "@repo/ui#typecheck": {
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "canyonos#build": {
      "cache": true,
      "outputs": ["dist/**"],
      "dependsOn": ["//#starters:bundle"]
    },
    "canyonos#build:binary": {
      "cache": false,
      "dependsOn": ["//#starters:bundle"],
      "command": [
        "uv",
        "run",
        "--no-sync",
        "python",
        "-m",
        "nuitka",
        "--mode=onefile",
        "--output-dir=dist",
        "--include-data-file=canyonos/dashboard.compose.yml=canyonos/dashboard.compose.yml",
        "--include-data-dir=canyonos/new_app_template=canyonos/new_app_template",
        "--include-data-dir=canyonos/starters=canyonos/starters",
        "--include-distribution-metadata=canyonos",
        "--assume-yes-for-downloads",
        "cli.py"
      ]
    },
    "canyonos#test:e2e": {
      "cache": false,
      "dependsOn": ["//#starters:bundle"],
      "passThroughEnv": ["PYTEST_ADDOPTS", "CANYONOS_ENV", "CANYONOS_CORE_IMAGE"],
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--package",
        "canyonos",
        "pytest",
        "tests/e2e"
      ]
    },
    "canyonos-python#lint": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "ruff",
        "check",
        "."
      ]
    },
    "canyonos-python#typecheck": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "ty",
        "check"
      ]
    },
    "canyonos-python#license:check": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "reuse",
        "lint"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/**"],
      "cache": false
    },
    "canyonos-python#format": {
      "cache": false,
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "ruff",
        "format",
        "."
      ]
    },
    "canyonos-python#format:check": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "ruff",
        "format",
        "--check",
        "."
      ]
    }
  }
}
