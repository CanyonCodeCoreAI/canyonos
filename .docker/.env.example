# Host port overrides. Compose picks defaults when unset.
# POSTGRES_HOST_PORT=5432
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# REDIS_HOST_PORT=6379
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_UI_PORT=15672

# Postgres defaults for local development.
# POSTGRES_DB=canyonos
# POSTGRES_USER=canyonos
# POSTGRES_PASSWORD=canyonos

# Named volume overrides (use a per-project prefix to avoid collisions).
# POSTGRES_VOLUME=canyonos-postgres-data
# REDIS_VOLUME=canyonos-redis-data
# RABBITMQ_VOLUME=canyonos-rabbitmq-data
